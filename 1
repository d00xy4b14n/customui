        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local swatch = mk("Frame", {
        Size = UDim2.fromOffset(40, 18),
        Position = UDim2.new(1, -48, 0.5, -9),
        BackgroundColor3 = default or Color3.fromRGB(255, 0, 0),
        BorderSizePixel = 0,
    }, row)
    corner(swatch, 4)
    stroke(swatch, C.line, 1, 0.5)

    local btn = mk("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    local palette = {
        Color3.fromRGB(255, 0, 0),
        Color3.fromRGB(0, 255, 0),
        Color3.fromRGB(0, 150, 255),
        Color3.fromRGB(255, 200, 0),
        Color3.fromRGB(255, 0, 200),
        Color3.fromRGB(255, 255, 255),
        Color3.fromRGB(0, 0, 0),
        Color3.fromRGB(255, 120, 0),
    }
    local pi = 1

    btn.MouseButton1Click:Connect(function()
        pi = pi + 1
        if pi > #palette then pi = 1 end
        local col = palette[pi]
        swatch.BackgroundColor3 = col
        if callback then task.spawn(callback, col) end
    end)

    return {Set = function(_, c)
        swatch.BackgroundColor3 = c
        if callback then task.spawn(callback, c) end
    end}
end

--=== TAB CLASS ===

local Tab = {}
Tab.__index = Tab

local tabs = {}
local activeTab = nil

function Tab.new(name, icon, order)
    local self = setmetatable({}, Tab)
    self.name = name

    local holder = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = order,
    }, tabList)

    local btn = mk("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = C.accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, holder)
    corner(btn, 8)

    local iconLbl = mk("TextLabel", {
        Size = UDim2.fromOffset(20, 20),
        Position = UDim2.fromOffset(12, 5),
        BackgroundTransparency = 1,
        Text = icon or "◆",
        TextColor3 = C.textDim,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
    }, holder)

    local label = mk("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.fromOffset(38, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.textDim,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    local scroll = mk("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, contentScroll)
    list(scroll, 10)

    self.holder = holder
    self.btn = btn
    self.iconLbl = iconLbl
    self.label = label
    self.scroll = scroll

    btn.MouseEnter:Connect(function()
        if activeTab ~= self then
            tw(btn, {BackgroundTransparency = 0.65}, E.snap)
            tw(label, {TextColor3 = C.text}, E.snap)
            tw(iconLbl, {TextColor3 = C.text}, E.snap)
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab ~= self then
            tw(btn, {BackgroundTransparency = 1}, E.snap)
            tw(label, {TextColor3 = C.textDim}, E.snap)
            tw(iconLbl, {TextColor3 = C.textDim}, E.snap)
        end
    end)

    btn.MouseButton1Click:Connect(function()
        if activeTab == self then return end
        if activeTab then
            tw(activeTab.btn, {BackgroundTransparency = 1}, E.out)
            tw(activeTab.label, {TextColor3 = C.textDim}, E.out)
            tw(activeTab.iconLbl, {TextColor3 = C.textDim}, E.out)
            activeTab.scroll.Visible = false
        end
        activeTab = self
        tw(btn, {BackgroundTransparency = 0.55}, E.out)
        tw(label, {TextColor3 = C.text}, E.out)
        tw(iconLbl, {TextColor3 = C.accentBright}, E.out)
        scroll.Visible = true

        local y = holder.AbsolutePosition.Y - tabList.AbsolutePosition.Y
        tw(indicator, {Position = UDim2.fromOffset(0, y + 2), BackgroundTransparency = 0}, E.glide)

        pageTitle.Text = name
    end)

    tabs[name] = self
    return self
end

function Tab:Section(title)
    return Section.new(self.scroll, title)
end

--=== UI ROOT ===

local UI = {}
UI.Tabs = {}
UI.Window = win
UI.Search = searchInput

function UI:Tab(name, icon)
    local t = Tab.new(name, icon, #self.Tabs + 1)
    table.insert(self.Tabs, t)

    if not activeTab then
        activeTab = t
        t.btn.BackgroundTransparency = 0.55
        t.label.TextColor3 = C.text
        t.iconLbl.TextColor3 = C.accentBright
        t.scroll.Visible = true
        pageTitle.Text = name
        task.defer(function()
            local y = t.holder.AbsolutePosition.Y - tabList.AbsolutePosition.Y
            indicator.Position = UDim2.fromOffset(0, y + 2)
            indicator.BackgroundTransparency = 0
        end)
    end

    return t
end

--=== DRAG ===

local dragging, dragStart, startPos, dragTween
local function updateDrag(input)
    local delta = input.Position - dragStart
    local np = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
    if dragTween then dragTween:Cancel() end
    dragTween = tw(win, {Position = np}, E.snap)
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = win.Position
        if dragTween then dragTween:Cancel() end
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

--=== OPEN/CLOSE ===

local closed = false

local function closeUI()
    if closed then return end
    closed = true
    tw(win, {
        Size = UDim2.fromOffset(W - 24, H - 24),
        Position = UDim2.new(0.5, -(W-24)/2, 0.5, -(H-24)/2 + 24),
        BackgroundTransparency = 1,
    }, E.out)
    tw(winStroke, {Transparency = 1}, E.out)
    task.delay(0.25, function() gui.Enabled = false end)
end

local function openUI()
    if not closed then return end
    closed = false
    gui.Enabled = true
    win.Size = UDim2.fromOffset(W - 24, H - 24)
    win.Position = UDim2.new(0.5, -(W-24)/2, 0.5, -(H-24)/2 + 24)
    win.BackgroundTransparency = 1
    winStroke.Transparency = 1
    tw(win, {
        Size = UDim2.fromOffset(W, H),
        Position = UDim2.new(0.5, -W/2, 0.5, -H/2),
        BackgroundTransparency = T.window,
    }, E.glide)
    tw(winStroke, {Transparency = T.stroke}, E.glide)
    tw(header, {BackgroundTransparency = T.header}, E.glide)
    tw(sidebar, {BackgroundTransparency = T.sidebar}, E.glide)
    tw(footer, {BackgroundTransparency = T.header + 0.08}, E.glide)
end

closeBtn.MouseButton1Click:Connect(closeUI)

--=== MINIMIZE ===

local minimized = false
local prevH = H

minBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        prevH = win.Size.Y.Offset
        tw(sidebar, {BackgroundTransparency = 1}, E.out)
        tw(contentScroll, {BackgroundTransparency = 1}, E.out)
        tw(pageTitle, {TextTransparency = 1}, E.out)
        for _, t in pairs(tabs) do
            tw(t.holder, {Position = UDim2.fromOffset(0, 18)}, E.out)
        end
        task.delay(0.10, function()
            tw(win, {Size = UDim2.fromOffset(win.Size.X.Offset, HEADER_H)}, E.glide)
            tw(footer, {BackgroundTransparency = 1}, E.out)
        end)
        task.delay(0.32, function()
            sidebar.Visible = false
            content.Visible = false
            footer.Visible = false
        end)
    else
        sidebar.Visible = true
        content.Visible = true
        footer.Visible = true
        sidebar.BackgroundTransparency = 1
        pageTitle.TextTransparency = 1
        for _, t in pairs(tabs) do
            t.holder.Position = UDim2.fromOffset(0, 18)
        end
        tw(win, {Size = UDim2.fromOffset(win.Size.X.Offset, prevH)}, E.glide)
        task.delay(0.05, function()
            tw(sidebar, {BackgroundTransparency = T.sidebar}, E.glide)
            tw(footer, {BackgroundTransparency = T.header + 0.08}, E.glide)
            tw(pageTitle, {TextTransparency = 0}, E.glide)
            for _, t in pairs(tabs) do
                tw(t.holder, {Position = UDim2.fromOffset(0, 0)}, E.glide)
            end
        end)
    end
end)

