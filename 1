        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valLbl = mk("TextLabel", {
        Size = UDim2.fromOffset(60, 14),
        Position = UDim2.new(1, -70, 0, 4),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = C.accentBright,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local box = mk("TextBox", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(10, 20),
        BackgroundColor3 = C.lineSoft,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Text = tostring(default),
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Center,
    }, row)
    corner(box, 4)

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then
            n = math.clamp(n, min, max)
            box.Text = tostring(n)
            valLbl.Text = tostring(n)
            if callback then task.spawn(callback, n) end
        else
            box.Text = tostring(default)
        end
    end)

    return {Set = function(_, v)
        v = math.clamp(v, min, max)
        box.Text = tostring(v)
        valLbl.Text = tostring(v)
        if callback then task.spawn(callback, v) end
    end}
end

function Section:Dropdown(name, options, default, callback)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = C.cardPressed,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
    }, self.frame)
    corner(row, 6)

    mk("TextLabel", {
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.fromOffset(10, 4),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local idx = 1
    for i, v in ipairs(options) do
        if v == default then idx = i break end
    end

    local btn = mk("TextButton", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(10, 20),
        BackgroundColor3 = C.lineSoft,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Text = options[idx] or "-",
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
    }, row)
    corner(btn, 4)

    local self_ref = {Options = options, Index = idx, Callback = callback, Button = btn}

    btn.MouseButton1Click:Connect(function()
        self_ref.Index = self_ref.Index + 1
        if self_ref.Index > #self_ref.Options then self_ref.Index = 1 end
        btn.Text = self_ref.Options[self_ref.Index]
        if self_ref.Callback then task.spawn(self_ref.Callback, self_ref.Options[self_ref.Index]) end
    end)

    return {
        Refresh = function(_, vals)
            self_ref.Options = vals
            self_ref.Index = 1
            btn.Text = vals[1] or "-"
        end,
        Set = function(_, v)
            for i, val in ipairs(self_ref.Options) do
                if val == v then
                    self_ref.Index = i
                    btn.Text = val
                    if self_ref.Callback then task.spawn(self_ref.Callback, val) end
                    break
                end
            end
        end
    }
end

