function Section.new(parent, title)
    local self = setmetatable({}, Section)
    local frame = mk("Frame", {
        Size = UDim2.new(1, -4, 0, 32),
        BackgroundColor3 = C.card,
        BackgroundTransparency = T.section,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, parent)
    corner(frame, 10)
    stroke(frame, C.line, 1, 0.75)
    list(frame, 6)
    pad(frame, 10, 12, 10, 12)

    mk("Frame", {
        Size = UDim2.new(0, 3, 0, 20),
        Position = UDim2.fromOffset(0, 10),
        BackgroundColor3 = C.accent,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
    }, frame)
    corner(frame:FindFirstChildWhichIsA("Frame"), 2)

    if title and title ~= "" then
        mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14),
            BackgroundTransparency = 1,
            Text = string.upper(title),
            TextColor3 = C.accentBright,
            Font = Enum.Font.GothamBold,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            LayoutOrder = 0,
        }, frame)
    end

    frame.MouseEnter:Connect(function()
        tw(frame, {BackgroundColor3 = C.cardHover}, E.snap)
        tw(frame:FindFirstChildOfClass("UIStroke"), {Transparency = 0.5}, E.snap)
    end)
    frame.MouseLeave:Connect(function()
        tw(frame, {BackgroundColor3 = C.card}, E.snap)
        tw(frame:FindFirstChildOfClass("UIStroke"), {Transparency = 0.75}, E.snap)
    end)

    self.frame = frame
    return self
end

function Section:Toggle(name, default, callback)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = C.cardPressed,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
    }, self.frame)
    corner(row, 6)

    mk("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.fromOffset(10, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local state = default and true or false
    local sw = mk("Frame", {
        Size = UDim2.fromOffset(36, 18),
        Position = UDim2.new(1, -44, 0.5, -9),
        BackgroundColor3 = state and C.accent or C.lineSoft,
        BorderSizePixel = 0,
    }, row)
    corner(sw, 9)

    local knob = mk("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = state and UDim2.new(1, -16, 0, 2) or UDim2.fromOffset(2, 2),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0,
    }, sw)
    corner(knob, 7)

    local btn = mk("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    local function setState(v, fire)
        state = v
        tw(sw, {BackgroundColor3 = state and C.accent or C.lineSoft}, E.snap)
        tw(knob, {Position = state and UDim2.new(1, -16, 0, 2) or UDim2.fromOffset(2, 2)}, E.snap)
        if fire and callback then task.spawn(callback, state) end
    end

    btn.MouseButton1Click:Connect(function() setState(not state, true) end)

    return {Set = function(_, v) setState(v, true) end, Value = state}
end

