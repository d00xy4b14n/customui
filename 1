    end
end)

--=== NOTIFICATION ===

function UI.Notify(title, content, duration)
    local toast = mk("Frame", {
        Size = UDim2.fromOffset(260, 0),
        Position = UDim2.new(1, -280, 1, -20),
        BackgroundColor3 = C.card,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, gui)
    corner(toast, 8)
    stroke(toast, C.accent, 1, 0.4)

    local padFrame = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, toast)
    pad(padFrame, 10, 12, 10, 12)
    list(padFrame, 4)

    mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = title or "Notice",
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, padFrame)

    if content and content ~= "" then
        mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = content,
            TextColor3 = C.textDim,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutomaticSize = Enum.AutomaticSize.Y,
        }, padFrame)
    end

    toast.Position = UDim2.new(1, -240, 1, -20)

    local task_holder = {}
    for i, existing in ipairs(gui:GetChildren()) do
        if existing ~= toast and existing:IsA("Frame") and existing:GetAttribute("__toast") then
            table.insert(task_holder, existing)
        end
    end
    toast:SetAttribute("__toast", true)

    local yOff = 20
    for _, t in ipairs(task_holder) do
        yOff = yOff + t.AbsoluteSize.Y + 8
    end

    task.defer(function()
        toast.Position = UDim2.new(1, -280, 1, -yOff - toast.AbsoluteSize.Y)
        tw(toast, {Position = UDim2.new(1, -280, 1, -yOff - toast.AbsoluteSize.Y + 20)}, E.glide)
    end)

    task.delay(duration or 4, function()
        tw(toast, {BackgroundTransparency = 1}, E.out)
        for _, c in ipairs(toast:GetDescendants()) do
            if c:IsA("TextLabel") then tw(c, {TextTransparency = 1}, E.out) end
        end
        task.delay(0.3, function() toast:Destroy() end)
    end)
end

return UI
