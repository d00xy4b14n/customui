    local q = searchInput.Text:lower()
    q = q:gsub("^%s+", ""):gsub("%s+$", "")

    local anyVisible = false
    local firstVisible = nil

    for name, tab in pairs(tabs) do
        local match = (q == "") or (name:lower():find(q, 1, true) ~= nil)
        tab.holder.Visible = match

        if match then
            anyVisible = true
            if not firstVisible then firstVisible = tab end
        end
    end

    if activeTab and not activeTab.holder.Visible and firstVisible then
        activeTab.btn.MouseButton1Click:Fire()
    end
end)

