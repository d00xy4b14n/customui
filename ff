local dragging, dragStart, startPos, dragTween
local function updateDrag(input)
    local delta = input.Position - dragStart
    local np = UDim2.new(
        startPos.X.Scale, startPos.X.Offset + delta.X,
        startPos.Y.Scale, startPos.Y.Offset + delta.Y
    )
    if dragTween then dragTween:Cancel() end
    dragTween = tw(win, {Position = np}, E.snap)
end

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = win.Position
        if dragTween then dragTween:Cancel() end
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        updateDrag(input)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local closed = false

local function collectTargets()
    local targets = {}
    table.insert(targets, {obj = win, prop = "BackgroundTransparency", orig = win.BackgroundTransparency})
    if winStroke then
        table.insert(targets, {obj = winStroke, prop = "Transparency", orig = winStroke.Transparency})
    end
    for _, d in ipairs(win:GetDescendants()) do
        if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("ImageButton") then
            table.insert(targets, {obj = d, prop = "BackgroundTransparency", orig = d.BackgroundTransparency})
        elseif d:IsA("TextLabel") or d:IsA("TextBox") then
            table.insert(targets, {obj = d, prop = "BackgroundTransparency", orig = d.BackgroundTransparency})
            table.insert(targets, {obj = d, prop = "TextTransparency", orig = d.TextTransparency})
        elseif d:IsA("ImageLabel") then
            table.insert(targets, {obj = d, prop = "BackgroundTransparency", orig = d.BackgroundTransparency})
            table.insert(targets, {obj = d, prop = "ImageTransparency", orig = d.ImageTransparency})
        elseif d:IsA("UIStroke") then
            table.insert(targets, {obj = d, prop = "Transparency", orig = d.Transparency})
        elseif d:IsA("ScrollingFrame") then
            table.insert(targets, {obj = d, prop = "BackgroundTransparency", orig = d.BackgroundTransparency})
            table.insert(targets, {obj = d, prop = "ScrollBarImageTransparency", orig = d.ScrollBarImageTransparency})
        end
    end
    return targets
end

local cachedTargets = nil

local function closeUI()
    if closed then return end
    closed = true

    task.spawn(function()
        local name = UI:GetAutoLoadName()
        if name and name ~= "" then
            UI:SaveConfig(name)
        end
    end)

    if not cachedTargets then
        cachedTargets = collectTargets()
    end

    for _, t in ipairs(cachedTargets) do
        tw(t.obj, {[t.prop] = 1}, E.glide)
    end

    task.delay(0.4, function()
        gui.Enabled = false
    end)
end

local function openUI()
    if not closed then return end
    closed = false

    if minimized then
        minimized = false
        sidebar.Visible = true
        content.Visible = true
        footer.Visible = true
        searchBox.Visible = true
        win.Size = _minRestoreSize or UDim2.fromOffset(W, H)
        if _minRestorePos then win.Position = _minRestorePos end
    end

    if not cachedTargets then
        cachedTargets = collectTargets()
    end

    gui.Enabled = true

    for _, t in ipairs(cachedTargets) do
        tw(t.obj, {[t.prop] = t.orig}, E.glide)
    end
end

closeBtn.MouseButton1Click:Connect(closeUI)

task.spawn(function()
    task.wait(0.05)
    cachedTargets = collectTargets()
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        if closed then openUI() else closeUI() end
    end
end)

function UI.Notify(title, content, duration)
    local toast = mk("Frame", {
        Size = UDim2.fromOffset(260, 0),
        Position = UDim2.new(1, -280, 1, -20),
        BackgroundColor3 = C.card,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, gui)
    corner(toast, 8)
    stroke(toast, C.accent, 1, 0.4)

    local padFrame = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, toast)
    pad(padFrame, 10, 12, 10, 12)
    list(padFrame, 4)

    mk("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16),
        BackgroundTransparency = 1,
        Text = title or "Notice",
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, padFrame)

    if content and content ~= "" then
        mk("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundTransparency = 1,
            Text = content,
            TextColor3 = C.textDim,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutomaticSize = Enum.AutomaticSize.Y,
        }, padFrame)
    end

    toast.Position = UDim2.new(1, -240, 1, -20)

    local task_holder = {}
    for i, existing in ipairs(gui:GetChildren()) do
        if existing ~= toast and existing:IsA("Frame") and existing:GetAttribute("__toast") then
            table.insert(task_holder, existing)
        end
    end
    toast:SetAttribute("__toast", true)

    local yOff = 20
    for _, t in ipairs(task_holder) do
        yOff = yOff + t.AbsoluteSize.Y + 8
    end

    task.defer(function()
        toast.Position = UDim2.new(1, -280, 1, -yOff - toast.AbsoluteSize.Y)
        tw(toast, {Position = UDim2.new(1, -280, 1, -yOff - toast.AbsoluteSize.Y + 20)}, E.glide)
    end)

    task.delay(duration or 4, function()
        tw(toast, {BackgroundTransparency = 1}, E.out)
        for _, c in ipairs(toast:GetDescendants()) do
            if c:IsA("TextLabel") then tw(c, {TextTransparency = 1}, E.out) end
        end
        task.delay(0.3, function() toast:Destroy() end)
    end)
end

