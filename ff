            Position = _minRestorePos or UDim2.new(0.5, -W/2, 0.5, -H/2),
        }, E.glide)
    else
        minimized = true

        _minRestorePos = win.Position
        _minRestoreSize = win.Size

        local centerX = win.AbsolutePosition.X + win.AbsoluteSize.X / 2
        local centerY = win.AbsolutePosition.Y + win.AbsoluteSize.Y / 2

        sidebar.Visible = false
        content.Visible = false
        footer.Visible = false
        searchBox.Visible = false
        titleLbl.Visible = false
        subtitleLbl.Visible = false

        tw(win, {
            Size = UDim2.fromOffset(_MIN_W, _MIN_H),
            Position = UDim2.fromOffset(centerX - _MIN_W / 2, centerY - _MIN_H / 2),
        }, E.glide)
    end
end

