local _autoFlagUsed = {}
local function _makeAutoFlag(name)
    local safe = tostring(name or "unnamed"):gsub("[^%w]", "_")
    local base = "fl_" .. safe
    local flag = base
    local n = 1
    while _autoFlagUsed[flag] do
        n = n + 1
        flag = base .. "_" .. n
    end
    _autoFlagUsed[flag] = true
    return flag
end

local function _register(ctrl, o)
    local flag = o.Flag or _makeAutoFlag(o.Name)
    UI.Controls[flag] = ctrl
    ctrl.__flag = flag
    ctrl.__name = o.Name
    return ctrl
end

function Section:AddToggle(o)
    o = o or {}
    return _register(self:Toggle(o.Name, o.Default, o.Callback), o)
end

function Section:AddSlider(o)
    o = o or {}
    return _register(self:Slider(o.Name, o.Min or 0, o.Max or 100, o.Default or 0, o.Callback), o)
end

function Section:AddDropdown(o)
    o = o or {}
    return _register(self:Dropdown(o.Name, o.Options or {}, o.Default, o.Callback), o)
end

function Section:AddInput(o)
    o = o or {}
    return _register(self:Input(o.Name, o.Default, o.Callback), o)
end

function Section:AddButton(o)
    o = o or {}
    return self:Button(o.Name, o.Callback)
end

function Section:AddLabel(o)
    if type(o) == "table" then o = o.Name or o.Text or "" end
    return self:Label(o)
end

function Section:AddParagraph(title, text)
    if type(title) == "table" then
        text = text or ""
        title = title.Title or title.Name or ""
    end
    self:Paragraph(title, text)
end

function Section:AddColorpicker(o)
    o = o or {}
    return _register(self:ColorPicker(o.Name, o.Default, o.Callback), o)
end

