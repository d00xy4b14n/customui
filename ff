local _currentPopupHolder = nil
local function _closeCurrentPopup()
    if _currentPopupHolder and _currentPopupHolder.Parent then _currentPopupHolder:Destroy() end
    if _currentPopup and _currentPopup.Parent then _currentPopup:Destroy() end
    _currentPopup = nil
    _currentPopupHolder = nil
end

function Section:Dropdown(name, options, default, callback)
    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundColor3 = C.cardPressed,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
    }, self.frame)
    corner(row, 6)

    mk("TextLabel", {
        Size = UDim2.new(1, -20, 0, 14),
        Position = UDim2.fromOffset(10, 4),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local idx = 1
    for i, v in ipairs(options) do
        if v == default then idx = i break end
    end

    local btn = mk("TextButton", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.fromOffset(10, 20),
        BackgroundColor3 = C.lineSoft,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Text = tostring(options[idx] or "-"),
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
    }, row)
    corner(btn, 4)
    pad(btn, 0, 0, 0, 8)

    mk("TextLabel", {
        Size = UDim2.fromOffset(16, 20),
        Position = UDim2.new(1, -20, 0, 0),
        BackgroundTransparency = 1,
        Text = "v",
        TextColor3 = C.textDim,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Center,
    }, btn)

    local self_ref = {Options = options, Index = idx, Callback = callback, Button = btn}

    local function openPopup()
        _closeCurrentPopup()

        local maxH = 220
        local h = math.min(#self_ref.Options * 22 + 8, maxH)

        local holder = mk("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 100,
        }, gui)

        local popup = mk("ScrollingFrame", {
            Size = UDim2.fromOffset(btn.AbsoluteSize.X, h),
            Position = UDim2.fromOffset(
                btn.AbsolutePosition.X,
                btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4
            ),
            BackgroundColor3 = C.card,
            BackgroundTransparency = 0.05,
            BorderSizePixel = 0,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = C.accent,
            ScrollBarImageTransparency = 0.4,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ZIndex = 101,
            ClipsDescendants = true,
        }, holder)
        corner(popup, 6)
        stroke(popup, C.accent, 1, 0.35)
        list(popup, 2)
        pad(popup, 4, 4, 4, 4)

        for i, opt in ipairs(self_ref.Options) do
            local isSel = (i == self_ref.Index)
            local optBtn = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundColor3 = isSel and C.accent or C.cardPressed,
                BackgroundTransparency = isSel and 0.35 or 0.55,
                BorderSizePixel = 0,
                Text = "  " .. tostring(opt),
                TextColor3 = isSel and C.white or C.text,
                Font = Enum.Font.Gotham,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                ZIndex = 102,
                LayoutOrder = i,
            }, popup)
            corner(optBtn, 4)

            optBtn.MouseEnter:Connect(function()
                if not isSel then
                    tw(optBtn, {BackgroundColor3 = C.cardHover, BackgroundTransparency = 0.3}, E.snap)
                end
            end)
            optBtn.MouseLeave:Connect(function()
                if not isSel then
                    tw(optBtn, {BackgroundColor3 = C.cardPressed, BackgroundTransparency = 0.55}, E.snap)
                end
            end)
            optBtn.MouseButton1Click:Connect(function()
                self_ref.Index = i
                btn.Text = tostring(opt)
                _closeCurrentPopup()
                if self_ref.Callback then task.spawn(self_ref.Callback, opt) end
            end)
        end

        _currentPopup = popup
        _currentPopupHolder = holder

        task.delay(0.05, function()
            local conn
            conn = UIS.InputBegan:Connect(function(input, gp)
                if gp then return end
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    _closeCurrentPopup()
                    if conn then conn:Disconnect() end
                end
            end)
        end)
    end

    btn.MouseButton1Click:Connect(function()
        if _currentPopup and _currentPopup.Parent then
            _closeCurrentPopup()
        else
            openPopup()
        end
    end)

    return {
        Refresh = function(_, vals, keepSel)
            local prev = self_ref.Options[self_ref.Index]
            self_ref.Options = vals

            if keepSel and prev then
                for i, v in ipairs(vals) do
                    if v == prev then
                        self_ref.Index = i
                        btn.Text = tostring(v)
                        return
                    end
                end
            end

            self_ref.Index = 1
            btn.Text = vals[1] and tostring(vals[1]) or "-"
        end,
        Set = function(_, v)
            for i, val in ipairs(self_ref.Options) do
                if val == v then
                    self_ref.Index = i
                    btn.Text = tostring(val)
                    if self_ref.Callback then task.spawn(self_ref.Callback, val) end
                    break
                end
            end
        end,
        Get = function() return self_ref.Options[self_ref.Index] end,
    }
end

