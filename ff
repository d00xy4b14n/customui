    pcall(function()
        if not isfolder(CONFIG_FOLDER) then makefolder(CONFIG_FOLDER) end
    end)
end

function UI:SetAutoLoad(name)
    if not writefile then return false end
    ensureFolder()
    return pcall(writefile, AUTOLOAD_FILE, tostring(name or ""))
end

function UI:GetAutoLoadName()
    if not readfile or not isfile then return nil end
    if not isfile(AUTOLOAD_FILE) then return nil end
    local ok, name = pcall(readfile, AUTOLOAD_FILE)
    if ok and type(name) == "string" and name:gsub("%s", "") ~= "" then
        return name
    end
    return nil
end

function UI:ClearAutoLoad()
    if not delfile or not isfile then return false end
    if isfile(AUTOLOAD_FILE) then
        pcall(delfile, AUTOLOAD_FILE)
        return true
    end
    return false
end

function UI:ApplyAutoLoad()
    local name = self:GetAutoLoadName()
    if not name then return false end
    local ok = self:LoadConfig(name, true)
    if ok then
        print("[FluentPro] Auto-loaded config: " .. name)
    end
    return ok
end

local function packValue(v)
    if typeof(v) == "Color3" then
        return {__k="Color3", r=math.floor(v.R*255+0.5), g=math.floor(v.G*255+0.5), b=math.floor(v.B*255+0.5)}
    elseif typeof(v) == "EnumItem" then
        return {__k="Enum", group=tostring(v.EnumType), name=v.Name}
    elseif typeof(v) == "Vector3" then
        return {__k="Vector3", x=v.X, y=v.Y, z=v.Z}
    elseif typeof(v) == "table" then
        local out = {}
        for k, vv in pairs(v) do out[k] = packValue(vv) end
        return out
    end
    return v
end

local function unpackValue(v)
    if type(v) ~= "table" then return v end
    if v.__k == "Color3" then return Color3.fromRGB(v.r, v.g, v.b) end
    if v.__k == "Enum" then
        local ok, item = pcall(function() return Enum[v.group:gsub("^Enum%.", "")][v.name] end)
        return ok and item or nil
    end
    if v.__k == "Vector3" then return Vector3.new(v.x, v.y, v.z) end
    return v
end

function UI:SaveConfig(name, setAuto)
    if not writefile then return false end
    ensureFolder()
    local data = {}
    for flag, ctrl in pairs(UI.Controls) do
        if ctrl.Get then
            local ok, val = pcall(ctrl.Get)
            if ok then data[flag] = packValue(val) end
        end
    end
    local ok, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then return false end
    local saved = pcall(writefile, CONFIG_FOLDER .. "/" .. name .. ".json", encoded)
    if saved and setAuto then
        UI:SetAutoLoad(name)
    end
    return saved
end

function UI:LoadConfig(name, setAuto)
    if not readfile or not isfile then return false end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, body = pcall(readfile, path)
    if not ok then return false end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok2 or type(decoded) ~= "table" then return false end
    for flag, val in pairs(decoded) do
        local ctrl = UI.Controls[flag]
        if ctrl and ctrl.Set then
            pcall(ctrl.Set, ctrl, unpackValue(val))
        end
    end
    if setAuto then
        UI:SetAutoLoad(name)
    end
    return true
end

function UI:ListConfigs()
    ensureFolder()
    local list = {}
    if not listfiles or not isfolder then return list end
    local ok, files = pcall(function()
        if not isfolder(CONFIG_FOLDER) then return nil end
        return listfiles(CONFIG_FOLDER)
    end)
    if not ok or type(files) ~= "table" then return list end
    for _, path in ipairs(files) do
        local n = path:match("([^/\\]+)%.json$")
        if n then table.insert(list, n) end
    end
    table.sort(list)
    return list
end

function UI:DeleteConfig(name)
    if not delfile then return false end
    local path = CONFIG_FOLDER .. "/" .. name .. ".json"
    if isfile and isfile(path) then
        pcall(delfile, path)
        return true
    end
    return false
end

