    btn.MouseButton1Click:Connect(function() setState(not state, true) end)

    return {
        Set = function(_, v) setState(v, true) end,
        Get = function() return state end,
    }
end

function Section:Slider(name, min, max, default, callback)
    local step = 1
    local range = max - min
    if range <= 5 then step = 0.01
    elseif range <= 50 then step = 0.1
    elseif range > 5000 then step = 100 end

    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = C.cardPressed,
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
    }, self.frame)
    corner(row, 6)

    mk("TextLabel", {
        Size = UDim2.new(1, -110, 0, 14),
        Position = UDim2.fromOffset(10, 6),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valLbl = mk("TextLabel", {
        Size = UDim2.fromOffset(100, 14),
        Position = UDim2.new(1, -110, 0, 6),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = C.accentBright,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local track = mk("TextButton", {
        Size = UDim2.new(1, -20, 0, 6),
        Position = UDim2.fromOffset(10, 34),
        BackgroundColor3 = C.lineSoft,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(track, 3)

    local fill = mk("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, track)
    corner(fill, 3)

    local knob = mk("Frame", {
        Size = UDim2.fromOffset(16, 16),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = C.white,
        BorderSizePixel = 0,
        ZIndex = 5,
    }, track)
    corner(knob, 8)
    stroke(knob, C.accent, 2, 0)

    local function toAlpha(v)
        if max == min then return 0 end
        return math.clamp((v - min) / (max - min), 0, 1)
    end

    local function roundStep(v)
        if step <= 0 then return v end
        return math.floor(v / step + 0.5) * step
    end

    local function format(v)
        if step < 1 then return string.format("%.2f", v) end
        return tostring(math.floor(v + 0.5))
    end

    local current = math.clamp(default, min, max)

    local function paint(v, fire)
        current = math.clamp(roundStep(v), min, max)
        local a = toAlpha(current)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        valLbl.Text = format(current)
        if fire and callback then task.spawn(callback, current) end
    end

    paint(current, false)
    task.defer(function()
        if callback then task.spawn(callback, current) end
    end)

    local active = false

    local function applyFromX(x)
        local relX = x - track.AbsolutePosition.X
        local a = math.clamp(relX / math.max(track.AbsoluteSize.X, 1), 0, 1)
        paint(min + (max - min) * a, true)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            applyFromX(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            applyFromX(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)

    return {
        Set = function(_, v) paint(v, true) end,
        Get = function() return current end,
    }
end

