searchInput:GetPropertyChangedSignal("Text"):Connect(function()
    local q = searchInput.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
    local searching = (q ~= "")
    clearBtn.Visible = searching

    local matchedTabs = {}
    local matchedSections = {}

    for _, item in ipairs(UI._searchItems) do
        local hit = (not searching) or (item.name:lower():find(q, 1, true) ~= nil)
        item.frame.Visible = hit
        if hit and searching then
            matchedSections[item.section] = true
            matchedTabs[item.tab] = true
        end
    end

    for _, sec in ipairs(UI._sections) do
        if searching then
            if sec.title ~= "" and sec.title:lower():find(q, 1, true) ~= nil then
                matchedSections[sec] = true
                matchedTabs[sec.tab] = true
                for _, el in ipairs(sec.elements) do el.frame.Visible = true end
            end
            sec.frame.Visible = (matchedSections[sec] == true)
        else
            sec.frame.Visible = true
        end
    end

    local firstValidTab = nil
    for _, tab in ipairs(UI.Tabs) do
        if searching then
            local ok = (matchedTabs[tab] == true)
            tab.holder.Visible = ok
            if ok and not firstValidTab then firstValidTab = tab end
        else
            tab.holder.Visible = true
        end
    end

    if searching and firstValidTab and (not matchedTabs[activeTab]) then
        firstValidTab:Select()
    end
end)

