            Size = UDim2.fromOffset(btn.AbsoluteSize.X, 0),
            BackgroundColor3 = C.panel,
            BackgroundTransparency = 0.06,
            BorderSizePixel = 0,
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = C.accent,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ClipsDescendants = true,
            ZIndex = 101,
        })
        corner(popup, 9)
        stroke(popup, C.strokeGlow, 1, 0.35)
        list(popup, 3)
        pad(popup, 5, 5, 5, 5)

        for i, opt in ipairs(self_ref.Options) do
            local isSel = (i == self_ref.Index)
            local optBtn = mk("TextButton", {
                Size = UDim2.new(1, 0, 0, 22),
                BackgroundColor3 = isSel and C.accent or C.row,
                BackgroundTransparency = isSel and 0.1 or 0.4,
                BorderSizePixel = 0,
                Text = "   " .. tostring(opt),
                TextColor3 = isSel and C.bg or C.text,
                Font = isSel and Enum.Font.GothamBold or Enum.Font.Gotham,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                ZIndex = 102,
            }, popup)
            corner(optBtn, 6)

            optBtn.MouseEnter:Connect(function()
                if not isSel then tw(optBtn, {BackgroundColor3 = C.rowHover, BackgroundTransparency = 0.2}, E.snap) end
            end)
            optBtn.MouseLeave:Connect(function()
                if not isSel then tw(optBtn, {BackgroundColor3 = C.row, BackgroundTransparency = 0.4}, E.snap) end
            end)
            optBtn.MouseButton1Click:Connect(function()
                self_ref.Index = i
                btn.Text = "   " .. tostring(opt)
                _closeCurrentPopup()
                if self_ref.Callback then task.spawn(self_ref.Callback, opt) end
            end)
        end

        _attachPopup(btn, tabRef, popup, nil, false, function()
            tw(arrow, {Rotation = 0}, E.out)
            tw(btnStroke, {Color = C.stroke, Transparency = 0.5}, E.snap)
        end)
        tw(popup, {Size = UDim2.fromOffset(btn.AbsoluteSize.X, targetH)}, E.out)
    end

    btn.MouseButton1Click:Connect(function()
        if _popupOwnerBtn == btn then
            _closeCurrentPopup()
        else
            openPopup()
        end
    end)

    return self:_track(name, row, {
        Refresh = function(_, vals, keepSel)
            local prev = self_ref.Options[self_ref.Index]
            self_ref.Options = vals or {}
            if keepSel and prev then
                for i, v in ipairs(self_ref.Options) do
                    if v == prev then
                        self_ref.Index = i
                        btn.Text = "   " .. tostring(v)
                        return
                    end
                end
            end
            self_ref.Index = 1
            btn.Text = "   " .. tostring(self_ref.Options[1] or "-")
        end,
        Set = function(_, v)
            for i, val in ipairs(self_ref.Options) do
                if val == v then
                    self_ref.Index = i
                    btn.Text = "   " .. tostring(val)
                    if self_ref.Callback then task.spawn(self_ref.Callback, val) end
                    break
                end
            end
        end,
        Get = function() return self_ref.Options[self_ref.Index] end,
    })
end

