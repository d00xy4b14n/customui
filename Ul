        activeTab = self
        tw(btn, {BackgroundTransparency = 0.35}, E.out)
        tw(label, {TextColor3 = C.text, Position = UDim2.fromOffset(38, 0)}, E.spring)
        tw(iconLbl, {TextColor3 = C.accent}, E.out)

