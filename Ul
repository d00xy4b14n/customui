local function getParent()
    for _, fn in ipairs({gethui, get_hidden_gui, gethiddengui, get_hidden_ui, gethiddenui}) do
        if type(fn) == "function" then
            local ok, h = pcall(fn)
            if ok and typeof(h) == "Instance" then return h end
        end
    end
    return game:GetService("CoreGui") or Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function mk(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props or {}) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end

local function corner(inst, r)
    return mk("UICorner", {CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 10)}, inst)
end

local function stroke(inst, color, thick, trans)
    return mk("UIStroke", {
        Color = color or C.stroke,
        Thickness = thick or 1,
        Transparency = trans or T.stroke,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, inst)
end

local function pad(inst, t, r, b, l)
    return mk("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or t or 0),
        PaddingBottom = UDim.new(0, b or t or 0),
        PaddingLeft = UDim.new(0, l or r or t or 0),
    }, inst)
end

local function list(inst, gap, dir, halign, valign)
    return mk("UIListLayout", {
        Padding = UDim.new(0, gap or 0),
        FillDirection = dir or Enum.FillDirection.Vertical,
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = valign or Enum.VerticalAlignment.Top,
    }, inst)
end

local function tw(obj, props, info)
    local a = TweenService:Create(obj, info or E.out, props)
    a:Play()
    return a
end

local function colorToHex(c)
    return string.format("#%02X%02X%02X",
        math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)
    )
end

local function hexToColor(str)
    if type(str) ~= "string" then return nil end
    local clean = str:gsub("%s+", ""):gsub("^#", "")
    if #clean == 3 then
        clean = clean:sub(1, 1):rep(2) .. clean:sub(2, 2):rep(2) .. clean:sub(3, 3):rep(2)
    end
    if #clean ~= 6 then return nil end
    local r = tonumber(clean:sub(1, 2), 16)
    local g = tonumber(clean:sub(3, 4), 16)
    local b = tonumber(clean:sub(5, 6), 16)
    if r and g and b then return Color3.fromRGB(r, g, b) end
    return nil
end

