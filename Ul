function Section:Slider(name, min, max, default, callback)
    local step = 1
    local range = max - min
    if range <= 5 then step = 0.01
    elseif range <= 50 then step = 0.1
    elseif range > 5000 then step = 100 end

    local row = mk("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = C.row,
        BackgroundTransparency = T.row,
        BorderSizePixel = 0,
    }, self.frame)
    corner(row, 9)
    stroke(row, C.stroke, 1, 0.7)

    mk("TextLabel", {
        Size = UDim2.new(1, -90, 0, 16),
        Position = UDim2.fromOffset(12, 6),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = C.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local valLbl = mk("TextLabel", {
        Size = UDim2.fromOffset(80, 16),
        Position = UDim2.new(1, -92, 0, 6),
        BackgroundTransparency = 1,
        Text = tostring(default),
        TextColor3 = C.accent,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local track = mk("TextButton", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.fromOffset(12, 32),
        BackgroundColor3 = C.bg,
        BackgroundTransparency = 0.25,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    }, row)
    corner(track, 3)
    stroke(track, C.stroke, 1, 0.5)

    local fill = mk("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 3)

    local knob = mk("Frame", {
        Size = UDim2.fromOffset(13, 13),
        Position = UDim2.new(0, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, track)
    corner(knob, 7)
    stroke(knob, C.bg, 2, 0)

    local current = math.clamp(default or min, min, max)

    local function paint(v, fire)
        local snapped = step > 0 and (math.floor(v / step + 0.5) * step) or v
        current = math.clamp(snapped, min, max)
        local a = (max > min) and ((current - min) / (max - min)) or 0
        tw(fill, {Size = UDim2.fromScale(a, 1)}, E.snap)
        tw(knob, {Position = UDim2.new(a, 0, 0.5, 0)}, E.snap)
        valLbl.Text = (step < 1) and string.format("%.2f", current) or tostring(math.floor(current + 0.5))
        if fire and callback then task.spawn(callback, current) end
    end

    paint(current, false)
    task.defer(function()
        if callback then task.spawn(callback, current) end
    end)

    local active = false
    local function applyFromX(x)
        local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        paint(min + (max - min) * a, true)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            tw(knob, {Size = UDim2.fromOffset(17, 17)}, E.spring)
            applyFromX(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            applyFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active = false
            tw(knob, {Size = UDim2.fromOffset(13, 13)}, E.out)
        end
    end)

    row.MouseEnter:Connect(function() tw(row, {BackgroundColor3 = C.rowHover, BackgroundTransparency = 0.22}, E.snap) end)
    row.MouseLeave:Connect(function() tw(row, {BackgroundColor3 = C.row, BackgroundTransparency = T.row}, E.snap) end)

    return self:_track(name, row, {
        Set = function(_, v) paint(v, true) end,
        Get = function() return current end,
    })
end

