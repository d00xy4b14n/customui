        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.accentSoft,
        ScrollBarImageTransparency = 0.45,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, content)
    list(scroll, 8)
    local scrollPad = pad(scroll, 2, 4, 10, 2)

    self.holder = holder
    self.btn = btn
    self.iconLbl = iconLbl
    self.label = label
    self.scroll = scroll
    self.scrollPad = scrollPad

    function self:Select()
        if activeTab == self then return end
        _closeCurrentPopup()
        if activeTab then
            tw(activeTab.btn, {BackgroundTransparency = 1}, E.out)
            tw(activeTab.label, {TextColor3 = C.textDim, Position = UDim2.fromOffset(34, 0)}, E.out)
            tw(activeTab.iconLbl, {TextColor3 = C.textFaint}, E.out)
            activeTab.scroll.Visible = false
