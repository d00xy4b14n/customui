        tw(indicator, {Position = UDim2.fromOffset(4, y + 14)}, E.spring)
    end

    btn.MouseEnter:Connect(function()
        if activeTab ~= self then
            tw(btn, {BackgroundTransparency = 0.65}, E.snap)
            tw(label, {TextColor3 = C.text, Position = UDim2.fromOffset(36, 0)}, E.snap)
        end
    end)
    btn.MouseLeave:Connect(function()
        if activeTab ~= self then
            tw(btn, {BackgroundTransparency = 1}, E.snap)
            tw(label, {TextColor3 = C.textDim, Position = UDim2.fromOffset(34, 0)}, E.snap)
        end
    end)
    btn.MouseButton1Click:Connect(function() self:Select() end)

    return self
