local _currentPopupHolder = nil
local _popupRenderConn = nil
local _popupInputConn = nil
local _popupOwnerBtn = nil
local _popupCleanup = nil

local function _closeCurrentPopup()
    if _popupRenderConn then _popupRenderConn:Disconnect(); _popupRenderConn = nil end
    if _popupInputConn then _popupInputConn:Disconnect(); _popupInputConn = nil end
    if _popupCleanup then pcall(_popupCleanup); _popupCleanup = nil end
    if _currentPopupHolder and _currentPopupHolder.Parent then
        local holderRef = _currentPopupHolder
        local body = holderRef:FindFirstChild("PopupBody")
        if body then
            tw(body, {Size = UDim2.fromOffset(body.AbsoluteSize.X, 0), BackgroundTransparency = 1}, E.snap)
            task.delay(0.14, function()
                if holderRef and holderRef.Parent then holderRef:Destroy() end
            end)
        else
            holderRef:Destroy()
        end
    end
    _currentPopupHolder = nil
    _popupOwnerBtn = nil
end

local function isInside(pt, obj)
    if not obj or not obj.Parent then return false end
    local p, s = obj.AbsolutePosition, obj.AbsoluteSize
    return pt.X >= p.X and pt.X <= (p.X + s.X) and pt.Y >= p.Y and pt.Y <= (p.Y + s.Y)
end

