local function iconBtn(symbol, order, isClose)
    local b = mk("TextButton", {
        Size = UDim2.fromOffset(30, 30),
        BackgroundColor3 = C.row,
        BackgroundTransparency = 0.35,
        BorderSizePixel = 0,
        Text = symbol,
        TextColor3 = C.textDim,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        AutoButtonColor = false,
        LayoutOrder = order,
    }, rightCluster)
    corner(b, 10)
    local s = stroke(b, C.stroke, 1, 0.5)
    local sc = mk("UIScale", {Scale = 1}, b)

    b.MouseEnter:Connect(function()
        tw(sc, {Scale = 1.07}, E.spring)
        if isClose then
            tw(b, {BackgroundColor3 = C.danger, BackgroundTransparency = 0.1, TextColor3 = C.text}, E.snap)
            tw(s, {Color = C.danger, Transparency = 0.1}, E.snap)
        else
            tw(b, {BackgroundColor3 = C.rowHover, BackgroundTransparency = 0.15, TextColor3 = C.text}, E.snap)
            tw(s, {Color = C.accentSoft, Transparency = 0.2}, E.snap)
        end
    end)
    b.MouseLeave:Connect(function()
        tw(sc, {Scale = 1}, E.out)
        tw(b, {BackgroundColor3 = C.row, BackgroundTransparency = 0.35, TextColor3 = C.textDim}, E.snap)
        tw(s, {Color = C.stroke, Transparency = 0.5}, E.snap)
    end)
    return b, sc
end

