local hasBranding = false
local function refreshBranding()
    local n = type(UI._u3name) == "string" and UI._u3name:match("^%s*(.-)%s*$") or ""
    local v = type(UI._u3version) == "string" and UI._u3version:match("^%s*(.-)%s*$") or ""

    if n == "" or v == "" then
        hasBranding = false
        logoTile.Visible = false
        titleLbl.Visible = false
        subtitleLbl.Visible = false
        return
    end

    hasBranding = true
    logoLetter.Text = string.upper(string.sub(n, 1, 1))
    titleLbl.Text = n
    subtitleLbl.Text = v

    logoTile.Visible = true
    titleLbl.Visible = true
    subtitleLbl.Visible = true
end

-- Scriptten u3name ve u3version atamak için metatable ve metodlar
setmetatable(UI, {
    __index = function(t, k)
        if k == "u3name" or k == "Name" then return rawget(t, "_u3name") end
        if k == "u3version" or k == "Version" then return rawget(t, "_u3version") end
        return rawget(t, k)
    end,
    __newindex = function(t, k, v)
        if k == "u3name" or k == "Name" then
            rawset(t, "_u3name", v)
            refreshBranding()
        elseif k == "u3version" or k == "Version" then
            rawset(t, "_u3version", v)
            refreshBranding()
        else
            rawset(t, k, v)
        end
    end
})

function UI:SetIdentity(name, version)
    self._u3name = name
    self._u3version = version
    refreshBranding()
    return self
end
UI.Window = UI.SetIdentity
UI.SetInfo = UI.SetIdentity

