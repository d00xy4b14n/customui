        _closeCurrentPopup()
        tw(arrow, {Rotation = 180}, E.out)
        tw(btnStroke, {Color = C.accent, Transparency = 0.25}, E.snap)

        local targetH = math.min(#self_ref.Options * 25 + 10, 190)
