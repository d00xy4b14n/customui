local function _attachPopup(ownerBtn, tabRef, popupBody, fixedWidth, alignRight, onCleanup)
    local holder = mk("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        ZIndex = 100,
    }, gui)

    popupBody.Name = "PopupBody"
    popupBody.Parent = holder

    local function syncPos()
        if closed or minimized or not ownerBtn or not ownerBtn.Parent or not ownerBtn.Visible then
            _closeCurrentPopup()
            return
        end
        if tabRef and tabRef.scroll and not tabRef.scroll.Visible then
            _closeCurrentPopup()
            return
        end
        local bp = ownerBtn.AbsolutePosition
        local bs = ownerBtn.AbsoluteSize

        -- Scroll dışına taşarsa kapat
        local cTop = content.AbsolutePosition.Y + 34
        local cBot = content.AbsolutePosition.Y + content.AbsoluteSize.Y
        if (bp.Y + bs.Y) < cTop or bp.Y > cBot then
            _closeCurrentPopup()
            return
        end

        local w = fixedWidth or bs.X
        local x = alignRight and (bp.X + bs.X - w) or bp.X
        local y = bp.Y + bs.Y + 5

        popupBody.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
        if not fixedWidth then
            popupBody.Size = UDim2.fromOffset(w, popupBody.Size.Y.Offset)
        end
    end

    syncPos()
    _currentPopupHolder = holder
    _popupOwnerBtn = ownerBtn
    _popupCleanup = onCleanup
    _popupRenderConn = RunService.RenderStepped:Connect(syncPos)

    task.delay(0.05, function()
        if _currentPopupHolder ~= holder then return end
        _popupInputConn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local pt = Vector2.new(input.Position.X, input.Position.Y)
                -- Header'dan pencereyi sürüklerken veya menü içine tıklarken listeyi kapatma
                if isInside(pt, popupBody) or isInside(pt, ownerBtn) or isInside(pt, header) then
                    return
                end
                _closeCurrentPopup()
            end
        end)
    end)
end

local dragging = false
local dragStartMouse = Vector2.zero
local dragStartPos = Vector2.zero

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
        dragStartPos = targetPos

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local m = Vector2.new(input.Position.X, input.Position.Y)
        targetPos = dragStartPos + (m - dragStartMouse)
    end
end)

local frames, elapsed = 0, 0
RunService.RenderStepped:Connect(function(dt)
    frames += 1
    elapsed += dt
    if elapsed >= 0.5 then
        fpsLabel.Text = string.format("%d fps", math.floor(frames / elapsed + 0.5))
        frames, elapsed = 0, 0
    end

    local step = math.min(dt, 0.033)

    local disp = targetPos - currentPos
    if not dragging and disp.Magnitude < 0.35 and posVel.Magnitude < 2 then
        currentPos = targetPos
        posVel = Vector2.zero
    else
        local posForce = disp * 150 - posVel * 16
        posVel = posVel + posForce * step
        currentPos = currentPos + posVel * step
    end

    local sizeDiff = targetSize - currentSize
    if sizeDiff.Magnitude < 0.35 and sizeVel.Magnitude < 2 then
        currentSize = targetSize
        sizeVel = Vector2.zero
    else
        local sizeForce = sizeDiff * 175 - sizeVel * 18
        sizeVel = sizeVel + sizeForce * step
        currentSize = currentSize + sizeVel * step
    end

    local vx = math.abs(posVel.X)
    local vy = math.abs(posVel.Y)

    local desiredX = math.clamp(vx * 0.015 - vy * 0.005, -10, 22)
    local desiredY = math.clamp(vy * 0.015 - vx * 0.005, -10, 22)
    local desiredStretch = Vector2.new(desiredX, desiredY)

    local stretchDiff = desiredStretch - stretchOffset
    if not dragging and stretchDiff.Magnitude < 0.25 and stretchVel.Magnitude < 1.5 then
        stretchOffset = Vector2.zero
        stretchVel = Vector2.zero
    else
        local sForce = stretchDiff * 140 - stretchVel * 15
        stretchVel = stretchVel + sForce * step
        stretchOffset = stretchOffset + stretchVel * step
    end

    local curW = math.max(120, math.floor(currentSize.X + stretchOffset.X + 0.5))
    local curH = math.max(HEADER_H, math.floor(currentSize.Y + stretchOffset.Y + 0.5))

    local renderX = math.floor(currentPos.X - stretchOffset.X * 0.5 + 0.5)
    local renderY = math.floor(currentPos.Y - stretchOffset.Y * 0.5 + 0.5)

    anchor.Size = UDim2.fromOffset(curW, curH)
    anchor.Position = UDim2.fromOffset(renderX, renderY)
end)

